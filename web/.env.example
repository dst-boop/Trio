# Production: set a 32-byte random base64 value as a Sites secret, never here.
# Preserve the same value across deployments; replacing it makes saved keys unreadable.
# To rotate, list NEW,OLD (comma-separated, newest first) until saved keys have moved, then NEW.
# Local development: use a separate synthetic value in ignored .dev.vars.
TRIO_CREDENTIAL_KEY=

# Optional workspace-provided provider keys. Set any of these as Sites secrets so
# signed-in users get that provider marked "Included with Trio" without adding a key.
# Usage bills the workspace owner's provider account; never commit real values.
TRIO_WORKSPACE_OPENAI_KEY=
TRIO_WORKSPACE_CLAUDE_KEY=
TRIO_WORKSPACE_GEMINI_KEY=

# Provider calls each account may make per UTC day on the keys above (default 200).
# Each request counts, retries included (Deep Council on three models: about 10). 0 = no limit.
# Users' own keys are never counted.
TRIO_WORKSPACE_DAILY_CALLS=

# Longest a single live run may take before it is stopped, in seconds (default 600).
TRIO_RUN_TIMEOUT_SECONDS=

# Optional tools to turn off, comma-separated: quality, comparison, work, audio, image, memory.
# Empty = everything on. Disabled tools are hidden and their API routes refuse requests.
TRIO_DISABLED_FEATURES=
