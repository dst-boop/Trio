{
  "name": "trio-intelligence-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "browser:setup": "node scripts/setup-browser.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:worker": "node scripts/test-browser.mjs --worker",
    "test": "node --test tests/*.test.ts",
    "test:worker": "node tests/worker-provider-transport.mjs && node tests/worker-saved-credentials.mjs && node tests/worker-quality-check.mjs && node tests/worker-work-comparison.mjs && node tests/worker-workspace-preferences.mjs && node tests/worker-action-plan-suggestions.mjs && node tests/worker-memory-suggestions.mjs && node tests/worker-access-auth.mjs",
    "eval:quality": "node scripts/evaluate-quality.mjs",
    "typecheck": "tsc --noEmit",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:standalone": "node scripts/standalone.mjs build",
    "dev:standalone": "node scripts/standalone.mjs dev",
    "deploy:standalone": "node scripts/standalone.mjs deploy",
    "migrate:standalone": "node scripts/standalone.mjs migrate"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
