# Copy this file to .env and fill in the keys you have.
# Trio runs with whichever of the three models have a key; all three is best.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override which model each vendor uses.
#CLAUDE_MODEL=claude-opus-5
#OPENAI_MODEL=gpt-6-astra
#GEMINI_MODEL=gemini-3.8-flash

# Which model writes the final answer: claude | openai | gemini
#SYNTHESIZER=claude

# STRONGLY RECOMMENDED before deploying anywhere public: anyone who can
# reach /api/ask is spending your API credits.
#APP_PASSWORD=

# Try the whole app with no API keys (fake answers).
#TRIO_MOCK=1

# Tuning knobs (defaults shown).
#MAX_OUTPUT_TOKENS=4000
#MODEL_TIMEOUT_SECONDS=240
#MAX_CONCURRENT_RUNS=8

# Questions per minute from one address; 0 turns the limit off.
#ASK_RATE_LIMIT_PER_MINUTE=20

# Set to 1 only when a proxy you control sets X-Forwarded-For. Without a
# proxy, trusting it lets any caller claim a fresh rate-limit quota.
#TRUST_PROXY_HEADER=

# Saved conversations. Use a mounted volume path in containers.
#TRIO_DB=./trio.db
